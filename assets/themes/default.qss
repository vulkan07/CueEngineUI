/* NOTE: Theme parser reads this part and replaces $vars$ in the qss */
#PALETTE
bg1: #070705
bg2: #161616
bgmid: #1c1c1d
bg_darker2: #121211
bg3: #303030
bg4: #393939
border1: 3px
border2: 6px 
text1: #ffffff
text2: #ababab

hl_fg1: #344691
hl_fg2: #8f97ef
hl_bg: #16192b
hl_text: #7698ed

dis_text: #bdbdbd
dis_bg: #090909
dis_border: #232323

border_w: 1px
#ENDPALETTE

QWidget {
    border-radius: $border2$; 
    color: $text1$;
    padding: 2px;

    font-family: Arial;
    font-size: 11pt;
}

*:disabled {
    color: $dis_text$;
}

QTUI, QTUI QSplitter, #SecondaryWindow {
    background: $bg1$;
}

BPanel { 
    background: $bg2$;
    border-radius: $border2$;
    /*border: $border_w$ solid $bg3$;*/
    margin:0;
    padding:0;
}
BPanel[focused] {
    border-color: $hl_fg1$;
}

QSplitter {
    margin:0;
}
QSplitter::handle {
    image: none;
}

QLineEdit:disabled,
QTextEdit:disabled,
QAbstractSpinBox:disabled
{
    background: $dis_bg$;
    border: $border_w$ solid $dis_border$;
}

QLineEdit, QTextEdit {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-right: 25px;
    padding-left: 2px;

    background-color: $bg3$;
    border-radius: $border1$;
    border: $border_w$ solid transparent;
}


QAbstractSpinBox:hover,
QLineEdit:hover,
QTextEdit:hover {
    border: $border_w$ solid $hl_fg1$;
}

QAbstractSpinBox:focus,
QLineEdit:focus,
QTextEdit:focus {
    border: $border_w$ solid $hl_fg2$;
    background: $hl_bg$;
}

QAbstractSpinBox
{
    padding-top: 2px;
    padding-bottom: 2px;
    padding-right: 25px;
    padding-left: 4px;
    
    background-color: $bg3$;
    border-radius: $border1$;

    height: 12px;
}

QAbstractSpinBox::up-button {
    border: $border_w$ solid #565656;
    padding: 3px;
    right: 2px;
    width: 12px;
    height: 12px;
    subcontrol-origin: border;
    subcontrol-position: center right;
    background: $bg4$;
    border-radius: $border1$;
}

QAbstractSpinBox::down-button {;
    border: $border_w$ solid #565656;
    padding: 3px;
    right: 24px;
    width: 12px;
    height: 12px;
    subcontrol-origin: border;
    subcontrol-position: center right;
    background: $bg4$;
    border-radius: $border1$;
}

QAbstractSpinBox::up-arrow {
    image: url(:/assets/images/spin-up.png);
}

QAbstractSpinBox::down-arrow {
    image: url(:/assets/images/spin-down.png);
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(:/assets/images/spin-up-disabled.png);
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(:/assets/images/spin-down-disabled.png);
}


QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    border: $border_w$ solid $hl_fg1$;
    background:  $hl_bg$;
}
QAbstractSpinBox::up-button:off,
QAbstractSpinBox::down-button:off {
    background:  #141414;
}


QMenuBar {
    font-size:10.5pt;
    margin:0;
}
QMenuBar::item {
    color: $text2$;
    padding: 1px 6px;
    margin-right: 3px;

    border-radius:2px;
    background: transparent;
}

QMenuBar::item:selected {
    color: $text1$;
    background: $bg4$;
}

QMenuBar::item:pressed {
    color: $text1$;
    background: $hl_fg1$;
}


QMenu {
    font-size:10.2pt;
    background: $bg2$;
    border: $border_w$ solid #505050;
    border-radius: $border1$;
    padding: 0;
}


QMenu::item {
    color: #e0e0e0;
    padding: 5px 11px 6px 15px;
}

QMenu::item:selected {
    color: white;
    background: $hl_fg1$;
}

QMenu::item:disabled {
    color: $dis_text$;
}

QMenu::icon {
    padding-left: 14px;
}

QMenu::separator {
    height: 2px;
    margin: 4px 0px 4px 0px;
    background-color: $bg4$;
}


QCheckBox::indicator {
    width: 11px;
    height: 11px;
    padding: 2px;
    margin-right:3px;
    border-radius: $border1$;
    border: $border_w$ solid $bg4$;
}
QMenu::indicator {
    width: 9px;
    height: 9px;
    padding: 2px;
    margin-left: 6px;
    border-radius: $border1$;
    border: $border_w$ solid $bg4$;
}
QCheckBox::indicator:unchecked:hover {
    border-color: $hl_fg1$;
}
QCheckBox::indicator:checked:hover {
    border-color: $hl_fg2$;
}
QCheckBox::indicator:unchecked,
QMenu::indicator:unchecked { 
    image: none; 
}

QCheckBox::indicator:checked,
QMenu::indicator:checked { 
    image: url(:/assets/images/check-on.png); 
    background: $hl_bg$;
    border-color: $hl_fg1$;
}

QCheckBox::indicator:disabled,
QMenu::indicator:disabled {
    border-color: none;
} 
QCheckBox::indicator:unchecked:disabled,
QMenu::indicator:unchecked:disabled {
    background: $dis_bg$;
}

QPushButton {
    padding: 3px 4px;
    background: $bg3$;
    border: $border_w$ solid $bg4$;
}

QPushButton:hover {
    border-color: $hl_fg1$;
    background: $hl_bg$;
}

QPushButton:pressed {
    border-color: $hl_fg2$;
    background: $hl_fg1$;
}

QPushButton:disabled {
    border-color: transparent;
    background: $dis_bg$;
}

PropertiesPanel {
    background: $bg_darker2$;
}

QTabWidget::tab-bar {
    left: 5px;
}

QTabWidget::pane {
    margin:0;
    border-top: $border_w$ solid $bg3$;
    background: $bg2$;
}

QTabBar::tab {
    padding: 4px 12px;
    border: $border_w$ solid $bg3$;
    border-bottom: none;
    border-top-left-radius: 4;
    border-top-right-radius: 4;
    background: $bg2$;
    margin-top: 3px;
    color: $text2$;

    margin-right: 0px;
}

QTabBar::tab:selected {
    color: $text1$;
    margin-top:1;
    padding-top:6px;
    border-color: $bg4$;
    background: $bg4$;
}

QTabBar::tab:hover {
    border-color: $hl_fg2$;
    color: $text1$;
}

QTabBar:focus {
    outline: 0; /* remove text underline */
}

QDialogButtonBox QPushButton {
    margin: 8px 0px;
    padding: 3px 5px;
}

SettingsWidget, SettingsWidget > QTabWidget > * {
    background: $bg1$;
}

QToolTip {
    border-color: $bg4$;
    background: $bg3$;
    color: $text1$;
    padding:2px;
    font-size:10pt;
}

QScrollBar {
    margin: 0px;
    background: $bg2$;
}
QScrollBar::vertical {
    width:10px;
}
QScrollBar::horizontal {
    height:10px;
}
QScrollBar::handle {
    background: $bg4$;
    border-radius: 3px;
}
QScrollBar::handle:hover {
    border:1px solid $hl_fg2$;
}
QScrollBar::handle:pressed {
    background: $hl_fg1$;
    border:1px solid $hl_fg2$;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

QComboBox {
    padding: 2px 4px;
    background: $bg3$;
    border-radius: $border1$;
    border: $border_w$ solid $bg4$;
}
QComboBox:hover,
QComboBox:on {
    border-color: $hl_fg1$;
}
QComboBox::drop-down {
    border-left: $border_w$ solid $bg4$;
    width: 18px;
    padding-left:4px;
    padding-right:3px;
}
QComboBox::down-arrow {
    image: url(:/assets/images/combo-down.png);
}
QComboBox QAbstractItemView {
    background: $bg2$;
    border: $border_w$ solid $bg4$;
    border-radius: $border1$;
}

#StatusTitle {
    font-size:22pt;
    margin:4px;
}

#ClockLCD {
    background: #101012;
    border-radius: 1;
    border: 1px solid #454545;
    margin: 4px;
}

CueListHeader > QLabel {
    font-weight: bold;
    background: $bg3$;
    border-radius: 0;
    margin: 0;
    padding: 3px 0px;
    border-bottom: 2px solid $bg2$;
}

#CueListScrollArea {
    margin: 0;
    padding: 0;
    background: $bg2$;
}

QFileDialog > QSplitter,
QFileDialog QTreeView,
QFileDialog QTreeView *
{
    margin: 0px;
    padding: 0px;
    background: $bg2$;
}

FoldingWidget {
    border: 2px solid #90101010;
    background: $bgmid$;
}
FoldingWidget > QPushButton {
    font-size: 11pt;
    font-weight: 600;
    background: #2b2b2a;
    border: none;
    border-radius: 2;
    image: url(:/assets/images/combo-down.png);
    image-position: right center;
    text-align: left;
}
FoldingWidget > QPushButton:hover {
    background: $bg4$;
}
FoldingWidget > #Line {
    background: $bg3$;
}
ShortcutWidget[state="modified"] {
    border: $border_w$ solid $hl_fg2$;
    background: $hl_bg$;
}
ShortcutWidget[state="invalid"] {
    border: $border_w$ solid #ff0000;
    background: #300000;
}
ShortcutWidget > QPushButton {
    image: url(:/assets/images/cross.png);
    padding: 5px;
}
SettingsShortcutsPage > QScrollArea {
    padding: 0px;
    background:$bg2$;
}
QKeySequenceEdit QWidget:focus {
    border-color: #dddd00;
    background: #554400;
}


PlayingCueWidget {

}
PlayingCueWidget QSplitter {
    border-radius: 0;
    background:transparent;
}
#PlayingCueTitle {
    font-size: 14pt;
    font-weight: 450;

    border-radius: 0;
    border: 1px solid #505050;
}
#PlayingCueIndex {
    font-weight: bold;
    background: #101012;
    border-radius: 0;
    border: 1px solid #505050;
    font-size: 12pt;
}
#PlayingCueIcon {
    border: 1px solid #505050;
    border-radius: 0;
}
#PlayingCueDescription {
    background: transparent;
    border-radius: 0;
    border: 1px solid #505050;
}
#PlayingCueRemaining {
    color: #ff0000;

    background: #101012;
    border-radius: 0;
    border: 1px solid #505050;
}
#PlayingCueElapsed {
    color: #00ff00;

    background: #101012;
    border-radius: 0;
    border: 1px solid #505050;
}
#PlayingCueDuration {
    color: #c0c0b0;

    background: #101012;
    border-radius: 0;
    border: 1px solid #505050;
}
#PlayingCueWaveform {
    border-radius: 0;
    border: 1px solid #505050;
}

CuePikkerWidget {
    //background: $bgmid$;
    //border-radius: $border1$;
    //border: 1px solid #4e4e4e;
}
CuePikkerWidget > QLabel {
    font-size: 12pt;
}

#CuePickerFrame {
    //background: $bg2$;
    //border-radius: $border1$;
    //border: 1px solid #4c4c4c;
}

CueItemWidget {
    background: #242424;
    border-radius: 2;
    border: 1px solid transparent;
}
CueItemWidget > QLabel {
    font-size: 10.5pt;
}

CueItemWidget:hover {
    border-color: $hl_fg2$;
    background: $hl_bg$;
}

#PropsPageTitle {
    font-size: 13pt;
}
#PropsCueTitle {
    font-size: 12pt;
    border-radius: 0;
}
#PropsCueIndex {
    border-radius: 0;
    border: 1px solid #505050;
    font-size: 12pt;
}
#PropsCueIcon {
    border: 1px solid #505050;
    border-radius: 0;
}
#PropsCueDesc {
    border-radius: 0;
}